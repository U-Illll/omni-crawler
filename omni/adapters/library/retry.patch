+def _retry_class_of_status(code):
+    """HTTP 状态码 → 类别（分类学；与「是否重试」解耦）。"""
+    try:
+        c = int(code)
+    except (TypeError, ValueError):
+        return 'other'
+    if c in RETRY_RATELIMIT_CODES:
+        return 'ratelimit'
+    if c in RETRY_AUTH_CODES:
+        return 'auth'
+    if 500 <= c <= 599:
+        return 'server_5xx'
+    if 400 <= c <= 499:
+        return 'other'
+    return 'other'
+
+
+def _retry_class_of_exc(e):
+    """异常 → 类别。判据 = 异常类名 + 消息文本特征（顺序敏感，见常量表）。"""
+    name = type(e).__name__
+    try:
+        msg = str(e)[:400].lower()
+    except Exception:
+        msg = ''
+    for t in _RETRY_DNS_TYPES:
+        if name == t:
+            return 'dns'
+    for m in _RETRY_DNS_MARKERS:
+        if m in msg:
+            return 'dns'
+    for t in _RETRY_CONNECT_TIMEOUT_TYPES:
+        if name == t:
+            return 'conn_reset'
+    for m in _RETRY_WRITE_MARKERS:
+        if m in msg:
+            return 'write_timeout'
+    for m in _RETRY_READ_MARKERS:
+        if m in msg:
+            return 'read_timeout'
+    for t in _RETRY_READ_TYPES:
+        if name == t:
+            return 'read_timeout'
+    for t in _RETRY_RESET_TYPES:
+        if name == t:
+            return 'conn_reset'
+    for m in _RETRY_RESET_MARKERS:
+        if m in msg:
+            return 'conn_reset'
+    return 'other'
+
