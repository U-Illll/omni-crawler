+  m="$(gen_match "$i" "$2" "${3:-}" "${4:-}")"
+  case "$m" in
+    exact)     return 0 ;;
+    none)      return 0 ;;   # 无世代记录：legacy 通道（调用方必须写 adopt_unverified）
