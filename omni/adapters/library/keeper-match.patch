+gen_rec_path()   { printf '%s/gen/%s.rec' "$KEEPER_STATE_DIR" "${JOB_NAME[$1]}"; }
+terminal_path()  { printf '%s/terminal/%s.json' "$KEEPER_STATE_DIR" "${JOB_NAME[$1]}"; }
+halt_path()      { printf '%s/halt/%s.json' "$KEEPER_STATE_DIR" "${JOB_NAME[$1]}"; }
